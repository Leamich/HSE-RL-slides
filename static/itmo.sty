% ============================================================
%  itmo.sty  —  ITMO University Beamer Theme
%  Engine  : pdfLaTeX
%  Usage   : \usepackage{itmo}  (after language packages)
%  Brand   : itmo.ru/en/info/brandbook  (iteration 1.1, 2022)
% ============================================================
\ProvidesPackage{itmo}[2026/05/24 ITMO University Beamer Theme]

% ── Dependencies ─────────────────────────────────────────────
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{hyperref}
\RequirePackage{lastpage}
\RequirePackage{graphicx}

\usetikzlibrary{calc}
\tcbuselibrary{skins}

% ── Localisation macros (override after \usepackage{itmo}) ───
% These defaults are ASCII so the .sty itself stays encoding-neutral.
\providecommand{\LogoPlaceholderText}{ITMO}
\providecommand{\ThankYouText}{Thank you!}
\providecommand{\ContactsText}{Contact}
\providecommand{\FeedbackText}{Feedback}

% ============================================================
%  ITMO BRAND COLOURS  (itmo.ru/en/info/brandbook, iter. 1.1)
% ============================================================
%  Base
\definecolor{ITMOBlack}     {HTML}{0D0D0D}  % primary dark background
\definecolor{ITMODark}      {HTML}{000000}  % pure black (footer bar)
\definecolor{ITMODarkAlt}   {HTML}{1A1A1A}  % slightly lifted dark surface
%  Brand accents
\definecolor{ITMOOrange}    {HTML}{F93F37}  % Tart Orange — primary accent
\definecolor{ITMOBlue}      {HTML}{0B68FE}  % Bluetiful — secondary accent
\definecolor{ITMOCyan}      {HTML}{00CCFF}  % Capri — bright accent
\definecolor{ITMOYellow}    {HTML}{FFCC33}  % Honey Yellow
\definecolor{ITMOGreen}     {HTML}{D0FF14}  % Green Lizard (neon)
\definecolor{ITMOViolet}    {HTML}{7F00FF}  % Violet Color Wheel
\definecolor{ITMOPink}      {HTML}{FC74FD}  % Pink Flamingo
%  Neutral tones
\definecolor{ITMOGray}      {HTML}{888888}  % neutral mid-gray
\definecolor{ITMOLightGray} {HTML}{F5F5F5}  % near-white slide background
%  Tints (for block bodies)
\definecolor{ITMOBlueTint}  {HTML}{E6F3FF}  % light blue tint
\definecolor{ITMOOrangeTint}{HTML}{FFF0EF}  % light orange tint
\definecolor{ITMOGreenSolid}{HTML}{1F7A4A}  % readable green (for example blocks)

% ============================================================
%  BEAMER MODE
% ============================================================
\mode<presentation>

\useoutertheme[subsection=false]{miniframes}

\useinnertheme{circles}

% Suppress all default headers/footers; we redraw via templates
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}

% ── Colour assignments ───────────────────────────────────────
\setbeamercolor{normal text}           {fg=black,          bg=white}
\setbeamercolor{alerted text}          {fg=ITMOOrange}
\setbeamercolor{example text}          {fg=ITMOGreenSolid}
\setbeamercolor{structure}             {fg=ITMOBlack}

\setbeamercolor{palette primary}       {fg=white,          bg=ITMODark}
\setbeamercolor{palette secondary}     {fg=white,          bg=ITMOBlue}
\setbeamercolor{palette tertiary}      {fg=white,          bg=ITMOCyan}
\setbeamercolor{palette quaternary}    {fg=ITMOBlack,      bg=ITMOOrange}

\setbeamercolor{section in head/foot}  {fg=white,          bg=ITMODarkAlt}
\setbeamercolor{frametitle}            {fg=white,          bg=ITMOBlack}
\setbeamercolor{framesubtitle}         {fg=ITMOOrange,     bg=ITMOBlack}

\setbeamercolor{block title}           {fg=white,          bg=ITMOBlue}
\setbeamercolor{block body}            {fg=black,          bg=ITMOBlueTint}
\setbeamercolor{block title alerted}   {fg=white,          bg=ITMOOrange}
\setbeamercolor{block body alerted}    {fg=black,          bg=ITMOOrangeTint}
\setbeamercolor{block title example}   {fg=white,          bg=ITMOGreenSolid}
\setbeamercolor{block body example}    {fg=black,          bg=ITMOGreenSolid!8}

\setbeamercolor{item}                  {fg=ITMOBlack}
\setbeamercolor{subitem}               {fg=ITMOBlue}
\setbeamercolor{subsubitem}            {fg=ITMOCyan}

\setbeamercolor{section in toc}        {fg=ITMOBlack}
\setbeamercolor{subsection in toc}     {fg=ITMOBlue}

% ── Fonts ────────────────────────────────────────────────────
\setbeamerfont{title}          {size=\Large,      series=\bfseries}
\setbeamerfont{subtitle}       {size=\normalsize, series=\mdseries}
\setbeamerfont{author}         {size=\small}
\setbeamerfont{institute}      {size=\small}
\setbeamerfont{date}           {size=\footnotesize}
\setbeamerfont{frametitle}     {size=\large,      series=\bfseries}
\setbeamerfont{framesubtitle}  {size=\small}
\setbeamerfont{section in toc} {series=\bfseries}

% ============================================================
%  HEADLINE  (horizontal section bubbles)
% ============================================================
\defbeamertemplate*{headline}{itmo theme}{%
	\leavevmode%
	\begin{beamercolorbox}[wd=\paperwidth,leftskip=0.4em,rightskip=0.4em]{section in head/foot}%
		\insertnavigation{\paperwidth}%
	\end{beamercolorbox}%
}

% ============================================================
%  FRAME TITLE
% ============================================================
\defbeamertemplate*{frametitle}{itmo theme}{%
	\nointerlineskip%
	\begin{beamercolorbox}[wd=\paperwidth,ht=2.9ex,dp=1.3ex,%
			leftskip=0.8em,rightskip=0.8em]{frametitle}%
		\usebeamerfont{frametitle}\insertframetitle%
		\ifx\insertframesubtitle\@empty\else
			\hfill
			{\usebeamerfont{framesubtitle}%
				\usebeamercolor[fg]{framesubtitle}%
				\insertframesubtitle}%
		\fi
	\end{beamercolorbox}%
}

% ============================================================
%  FOOTLINE
%  Left : \EventName  (defined in main.tex)
%  Right: page / total  (real PDF page numbers via lastpage)
% ============================================================
\providecommand{\EventName}{}   % fallback if user forgets

\defbeamertemplate*{footline}{itmo theme}{%
	\begin{beamercolorbox}[wd=\paperwidth,ht=2.4ex,dp=1.2ex,%
			leftskip=0.8em,rightskip=0.8em]{palette primary}%
		\usebeamerfont{author in head/foot}%
		\AuthorName\ifx\EventName\empty\else\quad\textbullet\quad\EventName\fi%
		\hfill%
		\insertpagenumber\,/\,\pageref{LastPage}%
		\hspace{0.3em}%
	\end{beamercolorbox}%
}

% ============================================================
%  TITLE PAGE
% ============================================================
\defbeamertemplate*{title page}{itmo theme}{%
	\begin{tikzpicture}[remember picture,overlay]
		%% ── Solid black background ─────────────────────────────
		\fill[ITMOBlack]
		(current page.south west) rectangle (current page.north east);

		%% ── Left orange accent stripe ──────────────────────────
		\fill[ITMOOrange]
		(current page.south west)
		rectangle ([xshift=7pt]current page.north west);

		%% ── Diagonal translucent accent (ITMO Blue) ────────────
		\fill[ITMOBlue,opacity=0.18]
		([xshift=7pt]current page.south west)
			-- ([xshift=120pt]current page.south west)
			-- ([xshift=7pt]current page.north west)
		-- cycle;

		%% ── Bottom orange band ─────────────────────────────────
		\fill[ITMOOrange]
		(current page.south west)
		rectangle ([yshift=7pt]current page.south east);

		%% ── Decorative dot grid (right side) ───────────────────
		\foreach \xi in {0.56,0.63,...,0.97}{
				\foreach \yi in {0.08,0.16,...,0.55}{
						\fill[white,opacity=0.055]
						($(current page.south west)!\xi!(current page.south east)!%
							\yi!(current page.north east)$)
						circle (1.4pt);
					}
			}

		%% ── Logo (top-right) ───────────────────────────────────
		%  Place a white-on-dark ITMO logo file at static/images/itmo_white.png
		\node[anchor=north east, inner sep=0pt]
		at ([xshift=-18pt,yshift=-14pt]current page.north east){%
			\includegraphics[height=1.2cm]{static/images/itmo_white.png}%
		};

		%% ── Event + location line ──────────────────────────────
		\node[anchor=north west,
			text=ITMOOrange, font=\footnotesize\itshape, inner sep=0pt]
		at ([xshift=20pt,yshift=-14pt]current page.north west){%
			\EventName\quad\textbullet\quad\EventLocation%
		};

		%% ── Main title ─────────────────────────────────────────
		\node[anchor=west,
			text=white, font=\Large\bfseries,
			text width=0.70\paperwidth, inner sep=0pt]
		at ([xshift=20pt,yshift=14pt]current page.west){%
			\PresentationTitle%
		};

		%% ── Subtitle ───────────────────────────────────────────
		\node[anchor=west,
			text=ITMOOrange, font=\normalsize,
			text width=0.68\paperwidth, inner sep=0pt]
		at ([xshift=20pt,yshift=-8pt]current page.west){%
			\PresentationSubtitle%
		};

		%% ── Horizontal divider ─────────────────────────────────
		\draw[ITMOOrange,line width=0.75pt]
		([xshift=20pt,yshift=-24pt]current page.west)
		-- ++(0.68\paperwidth,0);

		%% ── Author name ────────────────────────────────────────
		\node[anchor=north west,
			text=white, font=\small\bfseries, inner sep=0pt]
		at ([xshift=20pt,yshift=-31pt]current page.west){%
			\AuthorName%
		};

		%% ── Role / affiliation ─────────────────────────────────
		\node[anchor=north west,
			text=white!72!ITMOBlack, font=\footnotesize, inner sep=0pt]
		at ([xshift=20pt,yshift=-43pt]current page.west){%
			\AuthorRole%
		};
		\node[anchor=north west,
			text=white!72!ITMOBlack, font=\footnotesize, inner sep=0pt]
		at ([xshift=20pt,yshift=-54pt]current page.west){%
			\AuthorAffiliation%
		};

		%% ── Date (bottom-right) ────────────────────────────────
		\node[anchor=south east,
			text=white!60!ITMOBlack, font=\footnotesize, inner sep=0pt]
		at ([xshift=-18pt,yshift=12pt]current page.south east){%
			\PresentationDate%
		};
	\end{tikzpicture}%
}

%% Logo box helper — swap out for real logo in main.tex
\newcommand{\logobox}{%
	\begin{tikzpicture}
		\node[draw=ITMOOrange, line width=1pt,
			minimum width=2.4cm, minimum height=1.3cm,
			text=ITMOOrange, font=\tiny\bfseries,
			rounded corners=3pt, align=center, inner sep=5pt]{%
			\LogoPlaceholderText};
	\end{tikzpicture}%
}

% ============================================================
%  TABLE OF CONTENTS
% ============================================================
\setbeamertemplate{section in toc}{%
	\leavevmode\vspace{2pt}%
	\hspace*{0.4em}%
	\begin{tikzpicture}[baseline=-0.45ex]
		\node[circle, fill=ITMOBlack, text=white,
			font=\tiny\bfseries, inner sep=2.5pt]{%
			\inserttocsectionnumber};
	\end{tikzpicture}%
	\hspace*{0.5em}\inserttocsection\par%
}

% ============================================================
%  EMPHASIS COMMANDS
% ============================================================

%% \emred{text}  — orange-boxed inline emphasis (text)
\newtcbox{\emred}{%
	on line,
	arc=2pt,
	boxrule=0.75pt,
	colframe=ITMOOrange,
	colback=ITMOOrange!7,
	left=1.5pt, right=1.5pt, top=0.75pt, bottom=0.75pt,
	boxsep=0pt
}

\newcommand{\hlred}[1]{%
    \emred{$\displaystyle#1$}%
}

%% emphblock environment — standalone orange-border callout
%  Usage: \begin{emphblock}{Title} ... \end{emphblock}
\newtcolorbox{emphblock}[1]{%
	title={#1},
	arc=3pt,
	boxrule=1.2pt,
	colframe=ITMOOrange,
	colback=ITMOOrange!5,
	coltitle=white,
	colbacktitle=ITMOOrange,
	fonttitle=\bfseries\small,
	left=6pt, right=6pt, top=4pt, bottom=4pt,
	attach boxed title to top left={yshift=-2mm, xshift=5mm},
	boxed title style={arc=2pt, boxrule=0pt, colback=ITMOOrange}
}

% ============================================================
%  SLIDE LAYOUT COMMANDS
% ============================================================

%% Section divider slide
%  \sectionslide{Section Title}
\newcommand{\sectionslide}[1]{%
	\begin{frame}[plain,noframenumbering]
		\begin{tikzpicture}[remember picture,overlay]
			\fill[ITMOBlack]
			(current page.south west) rectangle (current page.north east);
			\fill[ITMOOrange]
			(current page.south west)
			rectangle ([xshift=6pt]current page.north west);
			\fill[ITMOOrange]
			(current page.south west)
			rectangle ([yshift=6pt]current page.south east);
			\node[anchor=north east, inner sep=0pt]
			at ([xshift=-18pt,yshift=-14pt]current page.north east){%
				\includegraphics[height=1.2cm]{static/images/itmo_white.png}%
			};
			\node[text=white, font=\Huge\bfseries,
				text width=0.74\paperwidth, align=center]
			at (current page.center){#1};
		\end{tikzpicture}
	\end{frame}%
}

%% One centered image with caption
%  \oneimage{file}{caption}{width}
\newcommand{\oneimage}[3]{%
	\begin{center}
		\includegraphics[width=#3]{#1}\\[5pt]
		{\small\color{ITMOGray}#2}
	\end{center}%
}

%% Two images side by side
%  \twoimages{left file}{left caption}{right file}{right caption}
\newcommand{\twoimages}[4]{%
	\begin{columns}[c]
		\column{0.48\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.56\textheight,
			keepaspectratio]{#1}\\[3pt]
		{\small\color{ITMOGray}#2}
		\column{0.48\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.56\textheight,
			keepaspectratio]{#3}\\[3pt]
		{\small\color{ITMOGray}#4}
	\end{columns}%
}

%% 2×2 image grid
%  \fourgrid{img1}{cap1}{img2}{cap2}{img3}{cap3}{img4}{cap4}
\newcommand{\fourgrid}[8]{%
	\begin{columns}[t]
		\column{0.48\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.37\textheight,
			keepaspectratio]{#1}\\[1pt]
		{\tiny\color{ITMOGray}#2}\\[5pt]
		\includegraphics[width=\linewidth,height=0.37\textheight,
			keepaspectratio]{#5}\\[1pt]
		{\tiny\color{ITMOGray}#6}
		\column{0.48\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.37\textheight,
			keepaspectratio]{#3}\\[1pt]
		{\tiny\color{ITMOGray}#4}\\[5pt]
		\includegraphics[width=\linewidth,height=0.37\textheight,
			keepaspectratio]{#7}\\[1pt]
		{\tiny\color{ITMOGray}#8}
	\end{columns}%
}

%% Image + text (picture right, bullets left)
%  \imagewithtext{file}{left-column content}
\newcommand{\imagewithtext}[2]{%
	\begin{columns}[c]
		\begin{column}{0.56\textwidth}
			#2
		\end{column}
		\begin{column}{0.44\textwidth}
			\includegraphics[width=\textwidth,height=\dimexpr\textheight-4.2ex\relax,keepaspectratio]{#1}
		\end{column}
	\end{columns}%
}

%% Two-column generic frame
%  \twocols{left content}{right content}
\newcommand{\twocols}[2]{%
	\begin{columns}[T]
		\column{0.48\textwidth}#1
		\column{0.48\textwidth}#2
	\end{columns}%
}

% ============================================================
%  FINAL SLIDE
%  \finalslide{contactURL}{feedbackURL}
% ============================================================
\newcommand{\finalslide}[2]{%
	\begin{tikzpicture}[remember picture,overlay]
		%% Background
		\fill[ITMOBlack]
		(current page.south west) rectangle (current page.north east);
		\fill[ITMOOrange]
		(current page.south west)
		rectangle ([xshift=7pt]current page.north west);
		\fill[ITMOOrange]
		(current page.south west)
		rectangle ([yshift=7pt]current page.south east);

		%% "Thank you" heading
		\node[text=white, font=\fontsize{30}{34}\selectfont\bfseries,
			anchor=center]
		at ([yshift=26pt]current page.center){\ThankYouText};

		%% Divider
		\draw[ITMOOrange,line width=0.8pt]
		([yshift=7pt]current page.center)
		+(-0.40\paperwidth,0) -- +(0.40\paperwidth,0);

		%% Author + event name line
		\node[text=white!75!ITMOBlack, font=\small, anchor=north, inner sep=0pt]
		at ([yshift=4pt]current page.center){%
			\AuthorName\quad\textbullet\quad\EventName};

		%% Left QR — contact
		\node[text=white, font=\footnotesize\bfseries,
			anchor=north, inner sep=0pt]
		at ([xshift=-0.22\paperwidth,yshift=-13pt]current page.center)
		{\ContactsText};

		\node[fill=white, inner sep=5pt, rounded corners=3pt,
			anchor=north]
		at ([xshift=-0.22\paperwidth,yshift=-28pt]current page.center){%
			\qrcode[height=1.7cm]{#1}};

		\node[text=ITMOOrange, font=\tiny, anchor=north, inner sep=0pt]
		at ([xshift=-0.22\paperwidth,yshift=-116pt]current page.center){%
			\href{#1}{\texttt{#1}}};

		%% Right QR — feedback
		\node[text=white, font=\footnotesize\bfseries,
			anchor=north, inner sep=0pt]
		at ([xshift=0.22\paperwidth,yshift=-13pt]current page.center)
		{\FeedbackText};

		\node[fill=white, inner sep=5pt, rounded corners=3pt,
			anchor=north]
		at ([xshift=0.22\paperwidth,yshift=-28pt]current page.center){%
			\qrcode[height=1.7cm]{#2}};

		\node[text=ITMOOrange, font=\tiny, anchor=north, inner sep=0pt]
		at ([xshift=0.22\paperwidth,yshift=-116pt]current page.center){%
			\href{#2}{\texttt{#2}}};
	\end{tikzpicture}%
}

\mode<all>
\endinput